FROM node:22-alpine AS base

# pnpm se obtiene vía corepack usando la versión fijada en package.json (packageManager)
RUN corepack enable

WORKDIR /app

# Etapa de compilación: instala TODAS las dependencias y genera dist/
FROM base AS build

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

# Typecheck + build: un error de tipos no debe producir una imagen
RUN pnpm run typecheck && pnpm run build:docker

# Etapa de ejecución: solo dependencias de producción y el artefacto compilado
FROM base AS runtime

ENV NODE_ENV=production

COPY package.json pnpm-lock.yaml* ./
# --ignore-scripts: evita el script `prepare` de husky (devDependency) en --prod
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

COPY --from=build /app/dist ./dist

# En dist/ ya está package.json con los alias de module-alias y swagger.json
WORKDIR /app/dist

EXPOSE 5000

CMD ["node", "index.js"]