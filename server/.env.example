
PORT=5000
HOST=localhost

ENVIROMENT=development

JWT_SECRET_TOKEN=tu_token_secreto_super_seguro_aqui_cambiar_en_produccion

# Coste de bcrypt (rondas); OWASP recomienda >= 10
JWT_SALT_TOKEN=10

# TTL del access token (formato ms). Baja a "10s" para probar la renovación vía refresh.
# ACCESS_TOKEN_EXPIRES_IN=15m

# Solo para igualar tiempos en el login (anti-enumeración); no debe coincidir con ninguna contraseña real
DUMMY_PASSWORD=dummy-password-for-timing

CORS_ALLOWED_DOMAINS="http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4000,http://localhost:4000"

# Habilitar solo detrás de un reverse proxy (nginx)
TRUST_PROXY=false

# Opcional: HTTPS local para simular producción (certificados mkcert en server/certs/).
# Ver .env.production.local y los scripts "start:prod" / "dev:prod".
# HTTPS_CERT_PATH=./certs/cert.pem
# HTTPS_KEY_PATH=./certs/key.pem

MONGO_DB_URI_DEVELOPMENT=mongodb://localhost:27017/mern_template_dev

MONGO_DB_URI_PRODUCTION=mongodb+srv://usuario:password@cluster.mongodb.net/mern_template_prod?retryWrites=true&w=majority
