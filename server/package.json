{
  "name": "mern-template-backend",
  "version": "1.0.0",
  "description": "Mern Template Backend",
  "main": "src/index.ts",
  "author": "libardo",
  "license": "ISC",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.1.0"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env ./src/index.ts",
    "dev": "nodemon --config nodemon.json",
    "start:prod": "tsx --env-file=.env.production.local ./src/index.ts",
    "dev:prod": "nodemon --watch src --ext ts,json --ignore node_modules --ignore dist --ignore coverage --ignore logs --ignore \"*.log\" --ignore .git --ignore .github --ignore .husky --ignore test --ignore tests --ignore .env --ignore \".env.*\" --ignore .prettierrc --ignore .prettierignore --delay 300 --exec \"tsx --env-file=.env.production.local ./src/index.ts\"",
    "build": "tsc",
    "build:docker": "rm -rf dist node_modules/.cache/tsconfig.tsbuildinfo && mkdir dist && tsc && cp src/swagger.json dist/ && cp src/swagger.json dist/src/ && cp package.json dist/ && cp dist/src/index.js dist/",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --coverage --testTimeout=10000 --collectCoverageFrom='./src/controllers/*.ts'",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix .",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "pre-commit": "npm run lint && npm run lint:fix && npm run format && npm run format:check",
    "prepare": "husky",
    "staged": "npx lint-staged --allow-empty",
    "husky:install": "npm run prepare && echo npm run staged > .husky/pre-commit",
    "compile": "rm -rf dist && mkdir dist && npm run build && cp src/swagger.json dist/ && cp src/swagger.json dist/src/ && cp package.json dist/ && cp .env dist/ && cp dist/src/index.js dist/",
    "build:zip": "npm run compile && npm install --omit=dev --prefix dist && (tar.exe -a -c -f ../lambda.zip dist)"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": "npm run pre-commit"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "bcryptjs": "3.0.3",
    "cli-table": "0.3.11",
    "compression": "1.8.2",
    "consola": "3.4.2",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "helmet-csp": "4.1.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.3",
    "module-alias": "2.3.5",
    "mongoose": "9.12.2",
    "morgan": "1.12.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "retry": "0.13.1",
    "swagger-ui-express": "5.0.1",
    "tsx": "^4.23.15",
    "yup": "1.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@types/cli-table": "^0.3.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/retry": "^0.12.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "nodemon": "3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "_moduleAliases": {
    "@middlewares": "./src/middlewares",
    "@helpers": "./src/helpers",
    "@validate": "./src/helpers/validate.js",
    "@models": "./src/models",
    "@validations": "./src/validations",
    "@controllers": "./src/controllers",
    "@services": "./src/services",
    "@config": "./src/config",
    "@routes": "./src/routes",
    "@schemas": "./src/schemas"
  }
}

