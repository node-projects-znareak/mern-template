# Plantilla de nginx para Railway. ${APP_PORT} se rellena en runtime con el
# puerto público que inyecta la plataforma (entrypoint.sh → envsubst).
server {
    listen ${APP_PORT};
    server_name _;

    client_max_body_size 1m;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta del frontend cae en index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API en el mismo origen (las cookies son first-party)
    location /api {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Health check del contenedor (Railway apunta aquí)
    location /health {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
